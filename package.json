{
  "name": "vscode-qemu-asm",
  "displayName": "QEMU Assembly Toolkit",
  "description": "在 VS Code 中调试 x86 汇编与 C 内核，支持 ELF/DWARF 源码、变量、分页与 QEMU 显示器。",
  "version": "0.7.0",
  "private": true,
  "publisher": "nothingzhl",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/nothingzhl/vscode-qemu-asm.git"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "tsc --noEmit -p ./",
    "test": "npm run compile && node --test test/*.test.cjs",
    "test:integration": "npm run compile && node scripts/integration.cjs",
    "test:host": "npm run compile && node scripts/host-test.cjs",
    "test:debug": "npm run compile && node scripts/debug-runtime-integration.cjs && node scripts/debug-integration.cjs",
    "test:display": "npm run compile && node scripts/display-integration.cjs",
    "test:display:ui": "npm run compile && node scripts/display-ui-test.cjs",
    "test:stage": "npm run compile && node scripts/stage-build-integration.cjs",
    "test:protected": "npm run compile && node scripts/protected-integration.cjs",
    "test:protected:ui": "npm run compile && node scripts/protected-ui-test.cjs",
    "test:inspection": "npm run compile && node scripts/inspection-integration.cjs",
    "test:inspection:ui": "npm run compile && node scripts/inspection-ui-test.cjs",
    "test:machine": "npm run compile && node scripts/watchpoint-runtime-integration.cjs && node scripts/machine-debug-integration.cjs",
    "test:machine:ui": "npm run compile && node scripts/machine-ui-test.cjs",
    "test:vsix:machine": "node scripts/vsix-machine-test.cjs",
    "test:paging": "npm run compile && node scripts/physical-memory-integration.cjs && node scripts/paging-integration.cjs",
    "test:paging:ui": "npm run compile && node scripts/paging-ui-test.cjs",
    "test:c-machine": "npm run compile && node scripts/c-machine-integration.cjs",
    "test:vsix:paging": "node scripts/vsix-paging-test.cjs",
    "test:c-source": "npm run compile && node scripts/c-source-integration.cjs",
    "test:c-source:ui": "npm run compile && node scripts/c-source-ui-test.cjs",
    "test:vsix:c-source": "node scripts/vsix-c-source-test.cjs"
  },
  "contributes": {
    "commands": [
      {
        "command": "qemuAsm.checkEnvironment",
        "title": "QEMU Assembly: 检查环境"
      },
      {
        "command": "qemuAsm.createProject",
        "title": "QEMU Assembly: 创建引导项目"
      },
      {
        "command": "qemuAsm.createProtectedProject",
        "title": "QEMU Assembly: 创建二阶段保护模式项目"
      },
      {
        "command": "qemuAsm.build",
        "title": "QEMU Assembly: 构建"
      },
      {
        "command": "qemuAsm.run",
        "title": "QEMU Assembly: 构建并运行"
      },
      {
        "command": "qemuAsm.stop",
        "title": "QEMU Assembly: 停止"
      },
      {
        "command": "qemuAsm.debug",
        "title": "QEMU Assembly: 开始引导调试"
      },
      {
        "command": "qemuAsm.showDisplay",
        "title": "QEMU Assembly: 显示模拟显示器"
      },
      {
        "command": "qemuAsm.showInspector",
        "title": "QEMU Assembly: 查看内存与描述符表",
        "icon": "$(inspect)"
      },
      {
        "command": "qemuAsm.showDisassembly",
        "title": "QEMU Assembly: 查看反汇编"
      },
      {
        "command": "qemuAsm.showDataBreakpoints",
        "title": "QEMU Assembly: 查看数据断点"
      },
      {
        "command": "qemuAsm.showPaging",
        "title": "QEMU Assembly: 查看分页与地址转换"
      }
    ],
    "configuration": {
      "title": "QEMU Assembly",
      "properties": {
        "qemuAsm.nasmPath": {
          "type": "string",
          "default": "nasm",
          "scope": "resource",
          "description": "NASM 可执行文件；相对路径以所选工作区为基准，裸命令从 PATH 查找。"
        },
        "qemuAsm.qemuPath": {
          "type": "string",
          "default": "qemu-system-i386",
          "scope": "resource",
          "description": "QEMU 可执行文件；相对路径以所选工作区为基准。"
        },
        "qemuAsm.projectDirectory": {
          "type": "string",
          "default": ".",
          "scope": "resource",
          "description": "包含 qemu-asm.json 的目录，相对所选工作区解析。"
        },
        "qemuAsm.qemuArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "附加参数数组，仅支持 -m、-cpu、-smp 及其值；例如 [\"-m\", \"32M\"]。"
        },
        "qemuAsm.gdbPath": {
          "type": "string",
          "default": "gdb",
          "scope": "resource",
          "description": "C/ELF 源码调试使用的 GDB 可执行文件；相对路径以所选工作区为基准。NASM 调试不需要 GDB。"
        }
      }
    },
    "languages": [
      {
        "id": "qemu-asm",
        "aliases": [
          "NASM（操作系统学习）"
        ],
        "extensions": [
          ".asm"
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "qemu-asm"
      },
      {
        "language": "c"
      }
    ],
    "debuggers": [
      {
        "type": "qemu-asm",
        "label": "QEMU 16/32 位引导调试",
        "languages": [
          "qemu-asm",
          "c"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [],
            "properties": {
              "stopOnEntry": {
                "type": "boolean",
                "default": true,
                "description": "暂停在入口：NASM 项目为 0x7c00；配置 debug.elf 的 C 项目为 debug.entry 或 ELF 入口。"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "qemu-asm",
            "request": "launch",
            "name": "操作系统学习：16/32 位引导调试",
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "QEMU 16/32 位引导调试",
            "description": "构建并调试所选工作区的引导与二阶段程序",
            "body": {
              "type": "qemu-asm",
              "request": "launch",
              "name": "操作系统学习：16/32 位引导调试",
              "stopOnEntry": true
            }
          }
        ]
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "qemuAsmInspector",
          "title": "QEMU 调试观察器",
          "icon": "media/inspector.svg"
        }
      ]
    },
    "views": {
      "qemuAsmInspector": [
        {
          "type": "webview",
          "id": "qemuAsm.inspector",
          "name": "调试观察器",
          "contextualTitle": "QEMU Assembly"
        }
      ]
    },
    "menus": {
      "debug/toolBar": [
        {
          "command": "qemuAsm.showInspector",
          "when": "debugType == qemu-asm",
          "group": "navigation@10"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.96.0",
    "@vscode/test-electron": "2.5.2",
    "typescript": "5.9.3"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "执行外部工具与创建项目需要工作区信任。"
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onDebugResolve:qemu-asm",
    "onDebugInitialConfigurations"
  ],
  "dependencies": {
    "iced-x86": "1.21.0"
  }
}
