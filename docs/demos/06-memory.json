  "captions": [
    {
      "time": 0.00005167600000277162,
      "text": "内存、变化高亮与栈跟随"
    },
    {
      "time": 0.5252180450000015,
      "text": "内存由暂停的真实 QEMU 读取：十六进制与 ASCII 同时显示"
    },
    {
      "time": 4.526514472000002,
      "text": "单步越过 NOP，定位将要写入内存的 INC"
    },
    {
      "time": 6.772960090000001,
      "text": "执行 INC：第三个双字从 0 变成 1，变化字节自动高亮"
    },
    {
      "time": 12.145544607,
      "text": "输入另一处真实地址：ASCII 栏识别内核成功字符串"
    },
    {
      "time": 16.591692533,
      "text": "切换到 SS:ESP：自动跟随当前栈，查看返回地址和栈数据"
    },
    {
      "time": 21.683713168,
      "text": "也可跟随 SS:EBP：把栈内存与左侧调用栈、寄存器对应起来"
    }
  ],
