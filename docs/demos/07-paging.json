    {
      "time": 0.00007405000000107975,
      "text": "分页、地址转换与物理内存"
    },
    {
      "time": 0.5010972660000007,
      "text": "分页已开启：CR3 → 页目录项 → 页表项 → 物理地址"
    },
    {
      "time": 4.5086618419999995,
      "text": "同一套页表也解释代码页权限：此映射只允许管理态访问"
    },
    {
      "time": 7.602292124000002,
      "text": "只读页面：CR0.WP 开启时，管理态写入同样被禁止"
    },
    {
      "time": 10.693050227000002,
      "text": "缺页会明确指出 P=0，不会伪造物理地址"
    },
    {
      "time": 13.781882507,
      "text": "PSE 4 MiB 大页：由页目录直接完成转换"
    },
    {
      "time": 17.870148428,
      "text": "虚拟地址 0xC0100000：查看内核刚刚写入的真实数据"
    },
    {
      "time": 21.966908543,
      "text": "切换物理地址 0x00210000：两个地址访问的是同一块 RAM"
    },
    {
      "time": 26.066252885,
      "text": "回到页表视图：映射关系、页标志与权限保持可见"
    }
  ],
