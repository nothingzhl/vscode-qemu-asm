{
  "all": true,
  "src": ["src"],
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/debug/**",
    "src/core.ts",
    "src/project/templates/**",
    "src/ports/{assembly,build,inspection,machine,presentation,session,source,virtualMachine}.ts",
    "src/domain/{inspection,paging}.ts",
    "src/backends/gdb/connection.ts",
    "src/composition/options.ts",
    "src/application/source/valuesModel.ts"
  ],
  "exclude-after-remap": true,
  "reporter": ["text-summary", "lcov", "json-summary", "html"],
  "reports-dir": "artifacts/coverage",
  "temp-directory": "artifacts/coverage/tmp",
  "check-coverage": true,
  "lines": 80,
  "statements": 80,
  "branches": 80,
  "functions": 85
}
